{
  "mcpServers": {
    "cadplot": {
      "command": "uv",
      "args": [
        "--directory",
        "C:/path/to/cadplot-mcp",
        "run",
        "cadplot-mcp"
      ],
      "env": {
        "CADPLOT_CONFIG": "C:/path/to/cadplot-mcp/config.yaml",
        "CADPLOT_PIPE_NAME": "cadplot-mcp",
        "CADPLOT_AUTOCAD_PROGID": "AutoCAD.Application"
      }
    }
  }
}
