<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net45</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- Set AutoCAD2016SdkDir to AutoCAD's managed assembly directory to build the ICommandClass. -->
    <AutoCADSdkAvailable Condition="Exists('$(AutoCAD2016SdkDir)\\AcMgd.dll') and Exists('$(AutoCAD2016SdkDir)\\AcDbMgd.dll') and Exists('$(AutoCAD2016SdkDir)\\AcCoreMgd.dll')">true</AutoCADSdkAvailable>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AutoCADSdkAvailable)' == 'true'">
    <DefineConstants>$(DefineConstants);AUTOCAD_SDK</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CadPlotMcp.Core\CadPlotMcp.Core.csproj" />
    <Compile Remove="AutodeskExtension.cs" Condition="'$(AutoCADSdkAvailable)' != 'true'" />
    <Compile Include="..\CadPlotMcp.AutoCAD.Shared\AutoCadPublishRuntime.cs" Link="AutoCadPublishRuntime.cs" Condition="'$(AutoCADSdkAvailable)' == 'true'" />
  </ItemGroup>
  <ItemGroup Condition="'$(AutoCADSdkAvailable)' == 'true'">
    <Reference Include="AcMgd"><HintPath>$(AutoCAD2016SdkDir)\AcMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcDbMgd"><HintPath>$(AutoCAD2016SdkDir)\AcDbMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcCoreMgd"><HintPath>$(AutoCAD2016SdkDir)\AcCoreMgd.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="RequireAutoCADSdk" BeforeTargets="CoreCompile" Condition="'$(BuildAutoCADPlugin)' == 'true' and '$(AutoCADSdkAvailable)' != 'true'">
    <Error Text="AutoCAD 2016 SDK references were not found. Set AutoCAD2016SdkDir to the folder containing AcMgd.dll, AcDbMgd.dll, and AcCoreMgd.dll." />
  </Target>
</Project>
