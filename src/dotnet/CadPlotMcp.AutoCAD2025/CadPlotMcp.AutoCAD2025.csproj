<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Set AutoCAD2025SdkDir to AutoCAD 2025's managed assembly directory for a production build. -->
    <AutoCADSdkAvailable Condition="Exists('$(AutoCAD2025SdkDir)\\AcMgd.dll') and Exists('$(AutoCAD2025SdkDir)\\AcDbMgd.dll') and Exists('$(AutoCAD2025SdkDir)\\AcCoreMgd.dll')">true</AutoCADSdkAvailable>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AutoCADSdkAvailable)' == 'true'">
    <DefineConstants>$(DefineConstants);AUTOCAD_SDK</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CadPlotMcp.Core\CadPlotMcp.Core.csproj" />
    <Compile Remove="AutodeskExtension.cs" Condition="'$(AutoCADSdkAvailable)' != 'true'" />
    <Compile Include="..\CadPlotMcp.AutoCAD.Shared\AutoCadPublishRuntime.cs" Link="AutoCadPublishRuntime.cs" Condition="'$(AutoCADSdkAvailable)' == 'true'" />
  </ItemGroup>
  <ItemGroup Condition="'$(AutoCADSdkAvailable)' == 'true'">
    <Reference Include="AcMgd"><HintPath>$(AutoCAD2025SdkDir)\AcMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcDbMgd"><HintPath>$(AutoCAD2025SdkDir)\AcDbMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcCoreMgd"><HintPath>$(AutoCAD2025SdkDir)\AcCoreMgd.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="RequireAutoCADSdk" BeforeTargets="CoreCompile" Condition="'$(BuildAutoCADPlugin)' == 'true' and '$(AutoCADSdkAvailable)' != 'true'">
    <Error Text="AutoCAD 2025 SDK references were not found. Set AutoCAD2025SdkDir to the folder containing AcMgd.dll, AcDbMgd.dll, and AcCoreMgd.dll." />
  </Target>
</Project>
